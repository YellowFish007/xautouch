#!/bin/sh
# XAutouch watchdog - 由 LaunchDaemon 拉起
#
# 设计约束（1.0.0-3 修正，重要）：
#   本脚本**只写日志，绝不 killall SpringBoard**。
#
#   1.0.0-2 的版本按 engine.log 的 mtime 判断"引擎卡死"，超过 600 秒就
#   kill -9 桌面。但全工程只有本脚本自己写 engine.log（且只在启动时写一行），
#   所以装完 10 分钟后必然进入"每 10 分钟杀一次桌面"的循环：
#       桌面被杀 -> tweak 重新注入 -> 崩 -> Safe Mode -> 10 分钟后再被杀
#   更致命的是：apt/dpkg 事务正跑时被杀，包会停在 reinstreq 状态，
#   此后 apt 全局报错：
#       E: The package app.xautouch.ios needs to be reinstalled,
#          but I can't find an archive for it.
#   于是连 Sileo 都无法卸载它。这是 1.0.0-2 在真机上表现"环境搞坏了"的根因。
#
#   现在改为纯观察模式：只记录，不动桌面。桌面异常由系统自己处理。
set +e
PREFIX=/usr/lib/xautouch
[ -d /var/jb/usr/lib/xautouch ] && PREFIX=/var/jb/usr/lib/xautouch
[ -d /rootfs/usr/lib/xautouch ] && PREFIX=/rootfs/usr/lib/xautouch

LOG="$PREFIX/logs/engine.log"
mkdir -p "$PREFIX/logs"

{
    echo "$(date) XAutouch watchdog started ($PREFIX)"
    echo "$(date) mode=observe-only（不会 respring，需要重启桌面请手动操作）"
} >> "$LOG" 2>/dev/null

while :; do
    if killall -0 SpringBoard >/dev/null 2>&1; then
        SB="alive"
    else
        SB="missing"
    fi
    echo "$(date) poll=60s springboard=$SB" >> "$LOG" 2>/dev/null

    # 日志自身滚动，避免无限增长
    if [ -f "$LOG" ]; then
        LINES=$(wc -l < "$LOG" 2>/dev/null)
        [ -n "$LINES" ] || LINES=0
        if [ "$LINES" -gt 2000 ]; then
            tail -n 500 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG" 2>/dev/null
        fi
    fi

    sleep 60
done
